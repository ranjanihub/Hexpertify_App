# Hexpertify environment variables. Copy to .env (repo root) and fill in.
# One file for everything: the website (apps/web), the API (server) and the panels (apps/*).

# Database (optional: server/src/config/database.ts has the shared URI)
MONGODB_URI=
DB_NAME=

# Website sign-in (NextAuth)
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Google sign-in (one OAuth client for the website and the API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_GOOGLE_CLIENT_SECRET=

# API sign-in tokens
SSO_SECRET=
JWT_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=
AUTH_EMAIL=
AUTH_EMAIL_PASSWORD=
MAIL_FROM=
ADMIN_EMAIL=

# Cloudinary (website media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=

# Web push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional
# DEFAULT_SESSION_FEE=1500
# PAYMENT_PENDING_EXPIRY_MINUTES=30
# CASHFREE_API_VERSION=2023-08-01
# BACKEND_PUBLIC_URL=        public site URL for payment webhooks (defaults to the Vercel domain)
# INTERNAL_API_KEY=          for outside callers of internal endpoints (session-reminder cron)
# GOOGLE_REDIRECT_URI=       defaults to <this site>/api/auth/google/callback
# PORT=5000                  standalone API only (npm run dev:server)
# VITE_LIVE_SITE_URL=        admin panel: website URL for zombie-page links (defaults to this site)
