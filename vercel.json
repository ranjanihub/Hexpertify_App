{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/vercel-build.js",
  "installCommand": "node scripts/vercel-install.js",
  "functions": {
    "Backend/api/index.ts": {
      "includeFiles": "Backend/public/**",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/Backend/api/index.ts"
    },
    {
      "source": "/api",
      "destination": "/Backend/api/index.ts"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/consultant/:match*",
      "destination": "/consultant/index.html"
    },
    {
      "source": "/((?!assets|admin/assets|consultant/assets|favicon.svg|hexpertify-logo.*|dr_sarah_jenkins.jpg|expertify-logo.png|icons.svg|logo.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
