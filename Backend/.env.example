PORT=5000
MONGODB_URI=
DB_NAME=hexpertify
SSO_SECRET=
# Required on Vercel: signs API tokens used for admin endpoints (refunds, transactions)
JWT_SECRET=
NODE_ENV=development

# SMTP Mail Configuration
SMTP_HOST=
SMTP_PORT=
AUTH_EMAIL=
AUTH_EMAIL_PASSWORD=
MAIL_FROM=

# Google OAuth 2.0 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Live Site Destination
LIVE_SITE_URL=

# ── Payments ──────────────────────────────────────────────
# Which gateway new checkouts use: razorpay | cashfree
PAYMENT_PROVIDER=razorpay
# Fallback session fee in INR when a service/consultant has no price
DEFAULT_SESSION_FEE=1500
# Unpaid checkouts are expired after this many minutes
PAYMENT_PENDING_EXPIRY_MINUTES=30
# Public URL of this backend (used for Cashfree notify_url), e.g. https://hexpertify-backend.vercel.app
BACKEND_PUBLIC_URL=
# Shared secret for server-to-server calls from Live_Panel (must match Live_Panel INTERNAL_API_KEY)
INTERNAL_API_KEY=

# Razorpay (Dashboard → Account & Settings → API Keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree (Dashboard → Developers → API Keys). Webhooks are signed with the secret key.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
