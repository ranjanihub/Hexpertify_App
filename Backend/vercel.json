{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "public/**/*.html",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "/public/admin/assets/$1"
    },
    {
      "src": "/consultant/assets/(.*)",
      "dest": "/public/consultant/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ]
}
