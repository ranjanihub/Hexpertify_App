{
  "name": "hexpertify-central-backend",
  "version": "1.0.0",
  "description": "Unified Central Backend & Identity Gateway for Hexpertify Ecosystem",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "vercel-build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "build:client": "npm --prefix ../Client_Panel/Client-Dashboard-Pro/artifacts/client-dashboard run build",
    "build:admin": "npm --prefix ../Super_Admin/admin_dashboard-main run build",
    "build:consultant": "npm --prefix ../Consultant_Panel/Therapy-Flow-Design/artifacts/hexpertify-dashboard run build",
    "build:panels": "npm run build:client && npm run build:admin && npm run build:consultant",
    "build:all": "npm run build:panels && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "mongodb": "^6.14.0",
    "nodemailer": "^9.0.6",
    "socket.io": "^4.8.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.1",
    "@vercel/node": "^5.1.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
