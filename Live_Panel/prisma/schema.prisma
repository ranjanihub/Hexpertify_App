generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------
// 1. Embedded Types
// -----------------------------------------------------

type FAQItem {
  question String
  answer   String
}

type TestimonialItem {
  quote              String
  authorName         String
  authorProfessional String?
  authorImageUrl     String?
  authorImageAltText String?
  authorEmail        String?
}

// -----------------------------------------------------
// 2. Enums
// -----------------------------------------------------

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum Role {
  USER
  ADMIN
  CONSULTANT
  THERAPIST
  CLIENT
  SUPER_ADMIN
}

// -----------------------------------------------------
// 3. Models
// -----------------------------------------------------

model Page {
  id                         String            @id @default(uuid()) @map("_id")
  identifier                 String            @unique
  notificationTitle          String?
  carouselImageUrls          String[]
  carouselImageAltTexts      String[]
  carouselImageIsMobileFlags Boolean[]
  faqs                       FAQItem[]
  testimonials               TestimonialItem[]
  seoMeta                    SeoMeta?          @relation("PageSeo", fields: [seoMetaId], references: [id], onDelete: NoAction)
  seoMetaId                  String?           @unique
}

model SeoMeta {
  id              String   @id @default(uuid()) @map("_id")
  metaTitle       String
  metaDescription String
  metaKeywords    String[]

  // Open Graph fields for social media
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  ogImageAlt    String?

  // HTML Chunk for structured data
  htmlChunk String?

  profession Profession? @relation("ProfessionSeo")
  consultant Consultant? @relation("ConsultantSeo")
  Page       Page?       @relation("PageSeo")
}

model Profession {
  id           String       @id @default(uuid()) @map("_id")
  name         String       @unique
  identifier   String       @unique
  imageUrl     String?
  imageAltText String?
  bannerUrl    String?
  bannerTitle  String?
  faqs         FAQItem[]
  consultants  Consultant[]
  seoMeta      SeoMeta?     @relation("ProfessionSeo", fields: [seoMetaId], references: [id], onDelete: NoAction)
  seoMetaId    String?      @unique

  createdAt DateTime @default(now())
}

model User {
  id            String    @id @default(uuid()) @map("_id")
  name          String?
  email         String?   @unique
  phoneNumber   String?
  password      String?
  role          Role      @default(USER)
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  reviews       Review[]
  bookings      Booking[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String?
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade) // <--- AND CHANGE THIS

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @unique
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
}

model Consultant {
  id                  String    @id @default(uuid()) @map("_id")
  name                String
  notificationTitle   String?
  sequence            Int?
  identifier          String    
  email               String    
  clientCount         Int       @default(0)
  photoUrl            String?
  photoAltText        String?
  youtubeUrl          String?
  certificateUrls     String[]
  certificateAltTexts String[]
  qualifications      String[]
  specialties         String[]
  experience          Int
  languages           String[]
  about               String?
  isCertified         Boolean   @default(false)
  faqs                FAQItem[]
  minPrice     Float?
  professionId String?
  profession   Profession? @relation(fields: [professionId], references: [id])

  services Service[]
  reviews  Review[]
  bookings Booking[]

  // --- SeoMeta Relation (One-to-One, owns the foreign key) ---
  seoMeta   SeoMeta? @relation("ConsultantSeo", fields: [seoMetaId], references: [id], onDelete: NoAction)
  seoMetaId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id           String @id @default(uuid()) @map("_id")
  name         String
  price        Float
  duration     Int
  sessionCount Int
  platform     String @default("G-Meet")

  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id            String     @id @default(uuid()) @map("_id")
  rating        Int
  comment       String?
  clientName    String? // Name of the client who gave the review
  clientTitle   String? // Client's profession/title
  imageUrls     String[] // Array of review/service images
  imageAltTexts String[] // Array of alt texts for review images
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id])
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Booking {
  id     String        @id @default(uuid()) @map("_id")
  status BookingStatus @default(PENDING)
  userId String
  user   User          @relation(fields: [userId], references: [id])

  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AssetCategory {
  PROFESSIONAL
  BLOG
  CONSULTANT
  BANNER
  CERTIFICATE
  ICON
  OTHER
}

model Asset {
  id        String        @id @default(uuid()) @map("_id")
  name      String        @default("Untitled")
  category  AssetCategory @default(OTHER)
  url       String
  publicId  String
  createdAt DateTime      @default(now())
}
